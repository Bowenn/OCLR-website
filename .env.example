# Canonical origin, without a path. HTTPS is required except on loopback.
APP_URL=http://localhost:3000
# PostgreSQL; explicitly choose sslmode=disable for the approved internal network,
# or sslmode=verify-full with a trusted CA for verified TLS.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/oclr?sslmode=disable
# Create an osu! OAuth application with callback APP_URL/auth/osu/callback.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
# Data collection requires a valid, explicitly approved privacy contact.
# One explicitly approved public osu! Admin ID; never the whole ADMIN_OSU_IDS list.
PRIVACY_CONTACT_OSU_ID=
# Tournament configuration is stored in PostgreSQL. See the one-time legacy import in docs/deployment.md.
# Bootstrap only: explicitly verified global administrator osu! IDs.
# Legacy STAFF_OSU_IDS is ignored and grants no access.
ADMIN_OSU_IDS=
# Optional exact loopback origins allowed for Developer API clients (comma-separated).
# Defaults to these two origins; an explicitly empty value disables issuance/CORS.
# OCLR_DEVELOPER_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional absolute path to approved bracket/result JSON (default: src/content/brackets.json).
# OCLR_BRACKETS_FILE=
# Optional absolute path to approved announcements (default: src/content/announcements.json).
# OCLR_ANNOUNCEMENTS_FILE=

# Production listener behind an HTTPS reverse proxy; setup/start default to loopback:3000.
# OCLR_BIND_HOST=127.0.0.1
# PORT=3000

# Inject only for production:setup / production:update; omit from the running service environment.
# MIGRATION_DATABASE_URL=
# Update command only; explicitly identify the intended external database.
# OCLR_ENVIRONMENT=production
# OCLR_EXPECTED_DB_HOST=YOUR_DATABASE_HOST
# OCLR_EXPECTED_DB_NAME=oclr
# OCLR_INSTALL_DIR=/opt/oclr
# OCLR_BACKUP_DIR=/var/lib/oclr/backups
# OCLR_SERVICE=oclr.service

# Durable private team avatar / replay storage; writable by the app user, outside release directories.
# Provision once on the app host: install -d -o oclr -g oclr -m 0700 /var/lib/oclr/media
OCLR_MEDIA_DIR=/var/lib/oclr/media

# Optional local frontend development only (next dev); no local DB or OAuth secret required.
# Keep APP_URL as the exact local loopback origin; API base is a separate backend origin.
# OCLR_DATA_SOURCE=remote
# OCLR_API_BASE_URL=https://YOUR_OCLR_BACKEND
# Connect at /remote using a short-lived token, or explicitly choose anonymous public reads.
# Never put tokens in this file, NEXT_PUBLIC_* values, URLs, or command-line arguments.
