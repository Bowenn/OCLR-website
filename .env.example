# Canonical origin, without a path. HTTPS is required except on loopback.
APP_URL=http://localhost:3000
# PostgreSQL; use verified TLS for a remote production database.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/oclr
# Create an osu! OAuth application with callback APP_URL/auth/osu/callback.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
# Data collection is disabled until an approved privacy contact/policy is configured.
PRIVACY_CONTACT_EMAIL=
PRIVACY_RETENTION_NOTICE=
# Tournament configuration is stored in PostgreSQL. See the one-time legacy import in docs/deployment.md.
# Bootstrap only: explicitly verified global administrator osu! IDs.
# Legacy STAFF_OSU_IDS is ignored and grants no access.
ADMIN_OSU_IDS=
# Optional absolute path to approved bracket/result JSON (default: src/content/brackets.json).
# OCLR_BRACKETS_FILE=
# Optional absolute path to approved announcements (default: src/content/announcements.json).
# OCLR_ANNOUNCEMENTS_FILE=
