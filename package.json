{
  "name": "oclr-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "i18n:extract": "node --import tsx scripts/i18n.ts",
    "test:i18n": "vitest run tests/unit/i18n.test.ts",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:integration": "vitest run tests/integration",
    "db:cleanup": "tsx scripts/cleanup.ts",
    "release:check": "tsx scripts/check-release.ts",
    "db:import-editions": "tsx scripts/import-editions.ts",
    "production:setup": "bash scripts/production.sh setup",
    "production:start": "bash scripts/production.sh start",
    "production:update": "bash scripts/update.sh",
    "media:cleanup": "tsx scripts/cleanup-media.ts"
  },
  "dependencies": {
    "@next/env": "16.4.2",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
